# ============================================================================
# EstateIQ AI/ML Service Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the real .env file into version control.
# ============================================================================

# Service Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL read access for batch ML jobs & feature extraction)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estateiq
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Backend Service Connection
BACKEND_API_URL=http://localhost:5000

# Trained Models Directory
MODEL_DIR=./app/trained_models
