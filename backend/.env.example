# ============================================================================
# EstateIQ Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the real .env file into version control.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estateiq
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# Security & JWT Secrets (Change these in real deployments!)
JWT_SECRET=super_secret_estateiq_jwt_access_token_key_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_estateiq_jwt_refresh_token_key_change_me
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin (Vite default is 5173)
CLIENT_URL=http://localhost:5173

# ML Service URL (FastAPI)
ML_SERVICE_URL=http://localhost:8000
